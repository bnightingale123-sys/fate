# Stripe 密钥配置
# 获取方式: https://dashboard.stripe.com/apikeys
# 测试密钥以 sk_test_ 开头，生产密钥以 sk_live_ 开头
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Webhook 密钥 (用于验证 Stripe 回调的真实性)
# 获取方式: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 网站域名
DOMAIN=https://yourfate.xyz

# 连连跨境支付 (LianLian Global) 配置
# 获取方式: https://docs.lianlianglobal.com.cn/ API文档
# 商户后台 → 开发者中心 → API密钥管理
#
# MERCHANT_ID  = 商户号 (developerId)
# AUTH_TOKEN   = API认证令牌 (masterToken)
# RSA_PRIVATE_KEY = 商户RSA私钥 PEM格式 (用于签名请求)
# RSA_PUBLIC_KEY  = 连连平台RSA公钥 PEM格式 (用于验签回调)
LIANLIAN_MERCHANT_ID=your_merchant_id_here
LIANLIAN_AUTH_TOKEN=your_auth_token_here
LIANLIAN_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your_private_key_content_here
-----END RSA PRIVATE KEY-----"
LIANLIAN_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
lianlian_public_key_content_here
-----END PUBLIC KEY-----"
LIANLIAN_API_BASE=https://api.lianlianglobal.com